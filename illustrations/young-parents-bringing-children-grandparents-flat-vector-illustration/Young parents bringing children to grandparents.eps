   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Young parents bringing children to grandparents. Flat vector illustration. Happy grandparents standing on porch, welcoming grandson and granddaughter running towards. Family, meeting, holiday concept</rdf:li>
